cmd_watch() {
    local wpid="$PREFIX/var/lib/tboost/watcher.pid"
    local wflag="$PREFIX/var/lib/tboost/watcher_active"
    
    clear
    printf "${C}  ╔════════════════════════════════════════╗${D}\n"
    printf "${C}  ║${D}  ${BD}AUTO-WATCHER DAEMON${D}                    ${C}║${D}\n"
    printf "${C}  ╚════════════════════════════════════════╝${D}\n\n"
    
    if [ -f "$wpid" ] && kill -0 "$(cat "$wpid" 2>/dev/null)" 2>/dev/null; then
        printf "  ${Y}[!]${D} Watcher berjalan (PID $(cat "$wpid"))\n"
        printf "  Hentikan? (y/n): "; read ans
        if [ "$ans" = "y" ]; then
            kill "$(cat "$wpid")" 2>/dev/null
            rm -f "$wpid" "$wflag"
            printf "  ${G}[+]${D} Watcher dihentikan.\n"
        fi
        return
    fi
    
    printf "  Watcher akan memonitor game:\n"
    printf "    ${G}*${D} Auto-boost saat game dibuka\n"
    printf "    ${G}*${D} Auto-restore saat game ditutup\n\n"
    printf "  Mulai watcher? (y/n): "; read ans
    [ "$ans" != "y" ] && return
    
    termux-wake-lock 2>/dev/null
    : > "$wflag"
    
    nohup setsid bash -c '
        wflag="'"$wflag"'"
        while [ -f "$wflag" ]; do
            if rish -c "ps -A" 2>/dev/null | grep -q "com.dts.freefiremax"; then
                if [ ! -f "$wflag.active" ]; then
                    rish -c "cmd game mode com.dts.freefiremax 1" 2>/dev/null
                    pid=$(rish -c "ps -A" 2>/dev/null | grep "com.dts.freefiremax" | awk "{print \$2}" | head -n1)
                    [ -n "$pid" ] && rish -c "renice -n -20 -p $pid" 2>/dev/null
                    touch "$wflag.active"
                fi
            else
                [ -f "$wflag.active" ] && rm -f "$wflag.active"
            fi
            sleep 5
        done
    ' >/dev/null 2>&1 &
    
    echo "$!" > "$wpid"
    printf "\n  ${G}[+]${D} Watcher aktif (PID $!)\n"
}

