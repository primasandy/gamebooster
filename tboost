cmd_fps_try() {
    local pkg pid
    pkg=$(get_game_pkg)
    pid=$(get_game_pid "$pkg")
    printf '  %sFPS attempt:%s\n\n' "$BD" "$D"
    if command -v rish >/dev/null 2>&1 && rish -c id 2>/dev/null | grep -q 'uid=2000'; then
        local out
        out=$(rish -c "dumpsys gfxinfo $pkg" 2>/dev/null)
        if printf '%s' "$out" | grep -q 'Total frames'; then
            printf '  %s[+]%s Via rish (Shizuku)\n' "$G" "$D"
            printf '%s\n' "$out" | grep -E 'Total frames|Janky|percentile' | head -5 | sed 's/^/      /'
            return 0
        fi
    fi
    local out2
    out2=$(dumpsys gfxinfo "$pkg" 2>/dev/null)
    if printf '%s' "$out2" | grep -q 'Total frames'; then
        printf '  %s[+]%s Via dumpsys\n' "$G" "$D"
        printf '%s\n' "$out2" | grep -E 'Total frames|Janky|percentile' | head -5 | sed 's/^/      /'
        return 0
    fi
    printf '  %s[-]%s FPS tidak bisa dibaca tanpa root/Shizuku aktif\n\n' "$Y" "$D" "$D"
    printf '  %sAlternatif metrics:%s\n' "$BD" "$D"
    local u n s id i w irq sirq st total busy
    read -r _ u n s id i w irq sirq st _ < /proc/stat
    total=$((u+n+s+id+i+w+irq+sirq+st))
    busy=$((total-id-i-w))
    [ "$total" -gt 0 ] && printf '      System CPU busy: %s%%\n' "$((busy * 100 / total))"
    local mt ma
    mt=$(awk '/MemTotal/{print $2}' /proc/meminfo)
    ma=$(awk '/MemAvailable/{print $2}' /proc/meminfo)
    [ "$mt" -gt 0 ] && printf '      RAM used: %s MB / %s MB\n' "$(( (mt-ma) / 1024 ))" "$(( mt / 1024 ))"
    printf '      Temp: %s C\n' "$(get_temp)"
    if [ -r /sys/class/kgsl/kgsl-3d0/gpuclk ]; then
        local g
        g=$(cat /sys/class/kgsl/kgsl-3d0/gpuclk 2>/dev/null)
        printf '      GPU: %s MHz\n' "$((g / 1000000))"
    fi
    [ -n "$pid" ] && [ -r "/proc/$pid/stat" ] && \
        printf '      FF CPU ticks: %s\n' "$(awk '{print $14+$15}' /proc/$pid/stat 2>/dev/null)"
}
cmd_sysdeep() {
    banner
    printf '  %sDEEP SYSTEM READ (no root)%s\n\n' "$BD" "$D"
    printf '  %s[CPU]%s\n' "$BD" "$D"
    local u n s i w irq sirq st total busy
    read -r _ u n s i w irq sirq st _ < /proc/stat
    total=$((u+n+s+i+w+irq+sirq+st)); busy=$((total-i-w))
    printf '      Busy: %s%% (idle %s%%)\n' "$((busy * 100 / total))" "$((i * 100 / total))"
    printf '\n  %s[MEMORY]%s\n' "$BD" "$D"
    awk '/MemTotal|MemFree|MemAvailable|Cached|SwapTotal/ {printf "      %-14s %6d MB\n", $1, $2/1024}' /proc/meminfo
    printf '\n  %s[LOAD]%s\n' "$BD" "$D"
    read -r l1 l5 l15 _ < /proc/loadavg
    printf '      1: %s  5: %s  15: %s\n' "$l1" "$l5" "$l15"
    printf '\n  %s[THERMAL]%s\n' "$BD" "$D"
    local z n t
    for z in /sys/class/thermal/thermal_zone*; do
        [ -r "$z/temp" ] || continue
        n=$(cat "$z/type" 2>/dev/null); t=$(cat "$z/temp" 2>/dev/null)
        [ "$t" -gt 1000 ] 2>/dev/null && t=$((t / 1000))
        printf '      %-24s %s C\n' "$n" "$t"
    done
    printf '\n  %s[BATTERY]%s\n' "$BD" "$D"
    for f in capacity temp voltage_now current_now status; do
        [ -r "/sys/class/power_supply/battery/$f" ] && \
            printf '      %-14s %s\n' "$f" "$(cat /sys/class/power_supply/battery/$f 2>/dev/null)"
    done
    printf '\n  %s[GPU]%s\n' "$BD" "$D"
    if [ -r /sys/class/kgsl/kgsl-3d0/gpuclk ]; then
        local cur mx bp
        cur=$(cat /sys/class/kgsl/kgsl-3d0/gpuclk 2>/dev/null)
        mx=$(cat /sys/class/kgsl/kgsl-3d0/max_gpuclk 2>/dev/null)
        bp=$(cat /sys/class/kgsl/kgsl-3d0/gpu_busy_percentage 2>/dev/null)
        printf '      Adreno: %s / %s MHz\n' "$((cur / 1000000))" "$((mx / 1000000))"
        [ -n "$bp" ] && printf '      Busy: %s\n' "$bp"
    else
        printf '      %s(no Adreno)%s\n' "$DM" "$D"
    fi
    printf '\n  %s[CPU freq per core]%s\n' "$BD" "$D"
    local i_core=0 cf
    for cf in /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq; do
        [ -r "$cf" ] || continue
        printf '      cpu%s: %s MHz\n' "$i_core" "$(( $(cat "$cf" 2>/dev/null) / 1000 ))"
        i_core=$((i_core + 1))
    done
    printf '\n  %s[FF MAX]%s\n' "$BD" "$D"
    local pid
    pid=$(get_game_pid)
    if [ -n "$pid" ]; then
        printf '      PID: %s\n' "$pid"
        [ -r "/proc/$pid/status" ] && grep -E 'Name|State|VmRSS|Threads' "/proc/$pid/status" 2>/dev/null | sed 's/^/      /' \
            || printf '      %s(/proc blokir)%s\n' "$Y" "$D"
    else
        printf '      not running\n'
    fi
    printf '\n  %s[TOP 10]%s\n' "$BD" "$D"
    ps -A -o PID,RSS,NAME 2>/dev/null | sort -k2 -n -r | head -11 | sed 's/^/      /'
}

