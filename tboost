# ========== OVERRIDE: Foreground detection multi-source ==========
get_fg_pkg() {
    local out pkg

    # Source 1: activity top (paling reliable, Android 10+)
    out=$(dumpsys activity top 2>/dev/null | grep -m1 "ACTIVITY ")
    pkg=$(printf '%s' "$out" | grep -oE '[a-zA-Z0-9._]+/[a-zA-Z0-9._]+' | head -1 | cut -d'/' -f1)
    [ -n "$pkg" ] && { printf '%s\n' "$pkg"; return; }

    # Source 2: window focus
    out=$(dumpsys window 2>/dev/null | grep -m1 -E "mCurrentFocus|mFocusedApp")
    pkg=$(printf '%s' "$out" | grep -oE '[a-zA-Z0-9._]+/[a-zA-Z0-9._]+' | head -1 | cut -d'/' -f1)
    [ -n "$pkg" ] && { printf '%s\n' "$pkg"; return; }

    # Source 3: activity activities (Android 9-15)
    out=$(dumpsys activity activities 2>/dev/null | grep -E "topResumedActivity|mResumedActivity|ResumedActivity" | grep -v "null" | head -1)
    pkg=$(printf '%s' "$out" | grep -oE '[a-zA-Z0-9._]+/[a-zA-Z0-9._]+' | head -1 | cut -d'/' -f1)
    [ -n "$pkg" ] && { printf '%s\n' "$pkg"; return; }

    # Source 4: focused activity (Android 8-)
    out=$(dumpsys activity 2>/dev/null | grep -m1 -E "mFocusedActivity|mFocusedApp")
    pkg=$(printf '%s' "$out" | grep -oE '[a-zA-Z0-9._]+/[a-zA-Z0-9._]+' | head -1 | cut -d'/' -f1)
    [ -n "$pkg" ] && { printf '%s\n' "$pkg"; return; }

    # Source 5: raw activity top tanpa filter
    out=$(dumpsys activity 2>/dev/null | grep -m1 "ACTIVITY")
    pkg=$(printf '%s' "$out" | grep -oE '[a-zA-Z0-9._]+/[a-zA-Z0-9._]+' | head -1 | cut -d'/' -f1)
    printf '%s\n' "$pkg"
}

cmd_fg() {
    banner
