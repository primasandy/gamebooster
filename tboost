#!/data/data/com.termux/files/usr/bin/bash
# tboost v3.0 - Gaming Performance Tool for Termux
VERSION="3.0"

R=$'\033[1;31m'; G=$'\033[1;32m'; Y=$'\033[1;33m'
B=$'\033[1;34m'; M=$'\033[1;35m'; C=$'\033[1;36m'
W=$'\033[1;37m'; D=$'\033[0m'; BD=$'\033[1m'; DM=$'\033[2m'

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
STATE_DIR="$PREFIX/var/lib/tboost"
BACKUP_DIR="$STATE_DIR/backup"
PIDFILE="$STATE_DIR/daemon.pid"
ALIVEFILE="$STATE_DIR/alive"
LOGFILE="$STATE_DIR/tboost.log"
GAME_FLAG="$STATE_DIR/game_mode"
mkdir -p "$STATE_DIR" "$BACKUP_DIR" 2>/dev/null || true

HAS_ROOT=0
SU_BIN=""

log() {
    local ts
    ts=$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null) || ts="??"
    printf '[%s] %s\n' "$ts" "$*" >> "$LOGFILE" 2>/dev/null || true
}

detect_root() {
    HAS_ROOT=0; SU_BIN=""
    if command -v su >/dev/null 2>&1; then
        if timeout 4 su -c id 2>/dev/null | grep -q 'uid=0'; then
            HAS_ROOT=1; SU_BIN="su"; return 0
        fi
    fi
    if command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
        HAS_ROOT=1; SU_BIN="sudo"
    fi
    return 0
}

as_root() {
    [ "$HAS_ROOT" -eq 1 ] || return 1
    if [ "$SU_BIN" = "su" ]; then su -c "$*"; else sudo sh -c "$*"; fi
}

get_freq() {
    local cur=0 mx=0 f=/sys/devices/system/cpu/cpu0/cpufreq
    [ -r "$f/scaling_cur_freq" ] && cur=$(cat "$f/scaling_cur_freq" 2>/dev/null)
    [ -r "$f/cpuinfo_max_freq" ] && mx=$(cat "$f/cpuinfo_max_freq" 2>/dev/null)
    printf '%s %s\n' "$((cur / 1000))" "$((mx / 1000))"
}

get_ram() {
    local t a
    t=$(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo 2>/dev/null)
    a=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo 2>/dev/null)
    [ -z "$t" ] && t=0
    [ -z "$a" ] && a=0
    printf '%s %s\n' "$t" "$a"
}

get_governor() {
    local g
    g=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)
    printf '%s\n' "${g:-unknown}"
}

get_soc() {
    local p v
    for p in ro.soc.model ro.board.platform ro.hardware ro.product.board; do
        v=$(getprop "$p" 2>/dev/null)
        [ -n "$v" ] && { printf '%s\n' "$v"; return; }
    done
    awk -F: '/Hardware|model name/{gsub(/^ +| +$/,"",$2); print $2; exit}' /proc/cpuinfo 2>/dev/null
}

temp_color() {
    local t=$1
    if [ "$t" -ge 75 ] 2>/dev/null; then printf '%s' "$R"
    elif [ "$t" -ge 60 ] 2>/dev/null; then printf '%s' "$Y"
    else printf '%s' "$G"; fi
}

backup_state() {
    log "backup_state"
    : > "$BACKUP_DIR/governor"
    for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -r "$f" ] || continue
        printf '%s=%s\n' "$f" "$(cat "$f" 2>/dev/null)" >> "$BACKUP_DIR/governor"
    done
    : > "$BACKUP_DIR/minfreq"
    for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_min_freq; do
        [ -r "$f" ] || continue
        printf '%s=%s\n' "$f" "$(cat "$f" 2>/dev/null)" >> "$BACKUP_DIR/minfreq"
    done
    if [ "$HAS_ROOT" -eq 1 ]; then
        as_root "settings get global window_animation_scale" > "$BACKUP_DIR/anim1" 2>/dev/null
        as_root "settings get global transition_animation_scale" > "$BACKUP_DIR/anim2" 2>/dev/null
        as_root "settings get global animator_duration_scale" > "$BACKUP_DIR/anim3" 2>/dev/null
    fi
}

restore_state() {
    log "restore_state"
    if [ -s "$BACKUP_DIR/governor" ]; then
        while IFS='=' read -r p v; do
            [ -n "$p" ] && as_root "echo '$v' > '$p'" 2>/dev/null || true
        done < "$BACKUP_DIR/governor"
    fi
    if [ -s "$BACKUP_DIR/minfreq" ]; then
        while IFS='=' read -r p v; do
            [ -n "$p" ] && as_root "echo '$v' > '$p'" 2>/dev/null || true
        done < "$BACKUP_DIR/minfreq"
    fi
    if [ "$HAS_ROOT" -eq 1 ]; then
        local a1 a2 a3
        a1=$(cat "$BACKUP_DIR/anim1" 2>/dev/null); [ -z "$a1" ] && a1="1.0"
        a2=$(cat "$BACKUP_DIR/anim2" 2>/dev/null); [ -z "$a2" ] && a2="1.0"
        a3=$(cat "$BACKUP_DIR/anim3" 2>/dev/null); [ -z "$a3" ] && a3="1.0"
        as_root "settings put global window_animation_scale $a1" 2>/dev/null || true
        as_root "settings put global transition_animation_scale $a2" 2>/dev/null || true
        as_root "settings put global animator_duration_scale $a3" 2>/dev/null || true
    fi
}

apply_tweaks() {
    local verbose="${1:-0}"
    local say
    if [ "$verbose" -eq 1 ]; then say() { printf '  %s\n' "$*"; }
    else say() { :; }; fi
    log "apply_tweaks"
    am kill-all >/dev/null 2>&1 || true
    say "${G}OK${D} Kill background apps (user scope)"
    if [ "$HAS_ROOT" -eq 1 ]; then
        as_root "pm trim-caches 999999999999" >/dev/null 2>&1 || true
        as_root "am kill-all" >/dev/null 2>&1 || true
        say "${G}OK${D} Kill background apps (system scope)"
        local ok=0 f mf g gp
        for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
            [ -w "$f" ] 2>/dev/null || continue
            if as_root "echo performance > '$f'" 2>/dev/null; then ok=$((ok + 1)); fi
        done
        [ "$ok" -gt 0 ] && say "${G}OK${D} Governor performance ($ok cores)" || say "${Y}!!${D} Governor not writable"
        ok=0
        for f in /sys/devices/system/cpu/cpu*/cpufreq; do
            [ -r "$f/cpuinfo_max_freq" ] && [ -w "$f/scaling_min_freq" ] 2>/dev/null || continue
            mf=$(cat "$f/cpuinfo_max_freq" 2>/dev/null); [ -z "$mf" ] && continue
            if as_root "echo $mf > '$f/scaling_min_freq'" 2>/dev/null; then ok=$((ok + 1)); fi
        done
        [ "$ok" -gt 0 ] && say "${G}OK${D} Min freq = max ($ok cores)"
        gp=0
        for g in /sys/class/kgsl/kgsl-3d0/devfreq/governor /sys/class/devfreq/*gpu*/governor; do
            [ -w "$g" ] 2>/dev/null || continue
            if as_root "echo performance > '$g'" 2>/dev/null; then gp=$((gp + 1)); fi
        done
        [ "$gp" -gt 0 ] && say "${G}OK${D} GPU governor performance"
        as_root "sync; echo 3 > /proc/sys/vm/drop_caches" 2>/dev/null || true
        say "${G}OK${D} Drop kernel caches"
        as_root "settings put global window_animation_scale 0.0" 2>/dev/null || true
        as_root "settings put global transition_animation_scale 0.0" 2>/dev/null || true
        as_root "settings put global animator_duration_scale 0.0" 2>/dev/null || true
        say "${G}OK${D} Animations disabled"
        for f in /sys/block/mmcblk*/queue/read_ahead_kb /sys/block/sd*/queue/read_ahead_kb; do
            [ -w "$f" ] 2>/dev/null && as_root "echo 128 > '$f'" 2>/dev/null || true
        done
        say "${G}OK${D} I/O read_ahead 128KB"
    else
        say "${Y}--${D} Limited mode (no root)"
    fi
}
daemon_alive() {
    [ -f "$PIDFILE" ] || return 1
    local pid
    pid=$(cat "$PIDFILE" 2>/dev/null)
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

cmd_status() {
    banner
    printf '%s\n' "${C}  --- Device Status --------------------------${D}"
    printf '  %-12s %s\n' "Model"    "$(getprop ro.product.model 2>/dev/null || echo unknown)"
    printf '  %-12s %s\n' "Android"  "$(getprop ro.build.version.release 2>/dev/null || echo unknown)"
    printf '  %-12s %s\n' "SoC"      "$(get_soc)"
    printf '  %-12s %s\n' "Cores"    "$(nproc 2>/dev/null || echo '?')"
    local rt ra ru rp cf mf tp tc
    read -r rt ra <<< "$(get_ram)"
    ru=$((rt - ra)); rp=0
    [ "$rt" -gt 0 ] && rp=$((ru * 100 / rt))
    printf '  %-12s %sMB / %sMB (%s%%)\n' "RAM" "$ru" "$rt" "$rp"
    read -r cf mf <<< "$(get_freq)"
    printf '  %-12s %s / %s MHz\n' "CPU Freq" "$cf" "$mf"
    printf '  %-12s %s\n' "Governor" "$(get_governor)"
    tp=$(get_temp); tc=$(temp_color "$tp")
    printf '  %-12s %s%s C%s\n' "CPU Temp" "$tc" "$tp" "$D"
    if [ "$HAS_ROOT" -eq 1 ]; then
        printf '  %-12s %sYES%s (full access)\n' "Root" "$G" "$D"
    else
        printf '  %-12s %sNO%s (limited)\n' "Root" "$Y" "$D"
    fi
    printf '%s\n' "${C}  --- Mode & Daemon --------------------------${D}"
    if [ -f "$GAME_FLAG" ]; then
        printf '  %-12s %sACTIVE%s\n' "Game Mode" "$G" "$D"
    else
        printf '  %-12s %sOFF%s\n' "Game Mode" "$DM" "$D"
    fi
    if daemon_alive; then
        printf '  %-12s %sRUNNING%s (PID %s)\n' "Daemon" "$G" "$D" "$(cat "$PIDFILE" 2>/dev/null)"
    else
        printf '  %-12s %sstopped%s\n' "Daemon" "$DM" "$D"
    fi
    printf '%s\n' "${C}  --------------------------------------------${D}"
}

start_daemon() {
    if daemon_alive; then
        printf '%s\n' "${Y}Daemon already running (PID $(cat "$PIDFILE"))${D}"
        return 0
    fi
    : > "$ALIVEFILE"
    nohup setsid "$0" _daemon >/dev/null 2>&1 &
    local pid=$!
    printf '%s\n' "$pid" > "$PIDFILE"
    command -v termux-wake-lock >/dev/null 2>&1 && termux-wake-lock 2>/dev/null || true
    printf '%s\n' "${G}OK${D} Daemon started (PID $pid)"
    printf '%s\n' "  ${DM}Wake-lock active. Stays alive after Termux closes.${D}"
}

stop_daemon() {
    rm -f "$ALIVEFILE"
    if [ -f "$PIDFILE" ]; then
        local pid
        pid=$(cat "$PIDFILE" 2>/dev/null)
        [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
        rm -f "$PIDFILE"
    fi
    pkill -f "tboost _daemon" 2>/dev/null || true
    command -v termux-wake-unlock >/dev/null 2>&1 && termux-wake-unlock 2>/dev/null || true
    printf '%s\n' "${G}OK${D} Daemon stopped"
}

_daemon_main() {
    printf '%s\n' "$$" > "$PIDFILE"
    log "daemon start pid=$$"
    trap 'log "daemon exit"; exit 0' TERM INT
    while [ -f "$ALIVEFILE" ]; do
        apply_tweaks 0
        sleep 25
    done
    log "daemon loop end"
}

cmd_game_on() {
    banner
    printf '%s\n' "${M}${BD}  >> Activating GAME MODE${D}"
    printf '\n'
    backup_state
    printf '  %s\n' "${G}OK${D} System state backed up"
    apply_tweaks 1
    : > "$GAME_FLAG"
    printf '\n'
    start_daemon
    printf '\n'
    printf '%s\n' "${G}${BD}  Game Mode ACTIVE.${D} Run ${BD}tboost game off${D} to stop."
}

cmd_game_off() {
    banner
    printf '%s\n' "${Y}${BD}  >> Deactivating GAME MODE${D}"
    printf '\n'
    stop_daemon
    restore_state
    rm -f "$GAME_FLAG"
    printf '  %s\n' "${G}OK${D} System state restored"
    printf '\n'
    printf '%s\n' "${G}${BD}  Game Mode OFF.${D}"
}
cmd_clean() {
    banner
    printf '%s\n' "${C}  Cleaning cache...${D}"
    local before after freed
    before=$(df -k "$PREFIX" 2>/dev/null | awk 'NR==2{print $4}')
    [ -z "$before" ] && before=0
    pkg clean >/dev/null 2>&1 || true
    rm -rf "${TMPDIR:-/tmp}"/* 2>/dev/null || true
    rm -rf "$HOME/.cache"/* 2>/dev/null || true
    rm -rf "$PREFIX/var/cache/apt/archives"/*.deb 2>/dev/null || true
    [ "$HAS_ROOT" -eq 1 ] && as_root "pm trim-caches 999999999999" >/dev/null 2>&1 || true
    after=$(df -k "$PREFIX" 2>/dev/null | awk 'NR==2{print $4}')
    [ -z "$after" ] && after=0
    freed=$(( (after - before) / 1024 ))
    printf '  %s\n' "${G}OK${D} Done. Freed: ${G}+${freed}MB${D}"
}

cmd_monitor() {
    banner
    printf '%s\n' "${C}  Live Monitor - Ctrl+C to stop${D}"
    printf '\n'
    printf '  %-10s %8s %10s %10s  %s\n' "TIME" "TEMP" "RAM" "CPU_FREQ" "GOVERNOR"
    trap 'printf "\n"; exit 0' INT
    while true; do
        local tp rt ra ru cf tc
        tp=$(get_temp); tc=$(temp_color "$tp")
        read -r rt ra <<< "$(get_ram)"
        ru=$((rt - ra))
        read -r cf _ <<< "$(get_freq)"
        printf '  %-10s %s%6s C%s %8sMB %8sMHz  %s\n' \
            "$(date +%H:%M:%S)" "$tc" "$tp" "$D" "$ru" "$cf" "$(get_governor)"
        sleep 2
    done
}

cmd_boot_install() {
    banner
    printf '%s\n' "${C}  Installing boot auto-start${D}"
    printf '%s\n' "  ${DM}Requires Termux:Boot app (F-Droid)${D}"
    mkdir -p "$HOME/.termux/boot"
    {
        printf '#!/data/data/com.termux/files/usr/bin/sh\n'
        printf 'termux-wake-lock 2>/dev/null\n'
        printf 'if [ -f %s ]; then\n' "$GAME_FLAG"
        printf '  %s _resume\n' "$HOME/bin/tboost"
        printf 'fi\n'
    } > "$HOME/.termux/boot/tboost.sh"
    chmod +x "$HOME/.termux/boot/tboost.sh"
    printf '  %s\n' "${G}OK${D} Installed: ~/.termux/boot/tboost.sh"
}
cmd_verify() {
    local missing=0 fn
    for fn in detect_root as_root get_temp get_freq get_ram get_governor get_soc \
              temp_color banner backup_state restore_state apply_tweaks \
              cmd_status daemon_alive start_daemon stop_daemon _daemon_main \
              cmd_game_on cmd_game_off cmd_clean cmd_monitor cmd_boot_install \
              cmd_menu cmd_help main; do
        type "$fn" >/dev/null 2>&1 || { printf 'MISSING: %s\n' "$fn"; missing=$((missing + 1)); }
    done
    if [ "$missing" -eq 0 ]; then
        printf '%s\n' "${G}All functions present. Script is complete.${D}"
    else
        printf '%s\n' "${R}$missing function(s) missing - re-paste affected chunk${D}"
        return 1
    fi
}


cmd_help() {
    banner
    printf '%s\n' "  Usage: tboost <command>"
    printf '\n'
    printf '%s\n' "  Interactive (default):   tboost"
    printf '\n'
    printf '%s\n' "  Commands:"
    printf '%s\n' "    tboost status         Device & daemon status"
    printf '%s\n' "    tboost game on        Enable Game Mode + persistent daemon"
    printf '%s\n' "    tboost game off       Disable & restore settings"
    printf '%s\n' "    tboost monitor        Live monitoring"
    printf '%s\n' "    tboost clean          Clean cache"
    printf '%s\n' "    tboost daemon start|stop|restart|status"
    printf '%s\n' "    tboost boot-install   Install boot auto-start"
    printf '%s\n' "    tboost verify         Check all functions present"
    printf '%s\n' "    tboost help           This help"
    printf '\n'
    printf '%s\n' "  Notes:"
    printf '%s\n' "    - Game Mode = performance gov + min=max freq + GPU perf"
    printf '%s\n' "      + kill background + animations off + cache clean"
    printf '%s\n' "    - Daemon uses termux-wake-lock -> stays alive after close"
    printf '%s\n' "    - Root = full system tweaks; no root = limited but safe"
}

get_fg_pkg() {
    local p
    p=$(dumpsys activity activities 2>/dev/null | grep -m1 -E 'mResumedActivity|topResumedActivity' | sed -E 's@.*[[:space:]]([a-zA-Z0-9._]+)/.*@\1@' | head -1)
    [ -z "$p" ] && p=$(dumpsys window 2>/dev/null | grep -m1 'mCurrentFocus' | sed -E 's@.*[[:space:]]([a-zA-Z0-9._]+)/.*@\1@')
    printf '%s\n' "$p"
}

cmd_fg() {
    banner
    local p; p=$(get_fg_pkg)
    printf '  Foreground: %s%s%s\n' "$G" "${p:-unknown}" "$D"
}

cmd_fps() {
    banner
    local pkg="$1"
    [ -z "$pkg" ] && pkg=$(get_fg_pkg)
    if [ -z "$pkg" ]; then
        printf '  %sForeground app not detected.%s\n' "$Y" "$D"
        printf '  Usage: tboost fps <package.name>\n'
        return 1
    fi
    printf '  Package: %s%s%s\n\n' "$G" "$pkg" "$D"
    local out; out=$(dumpsys gfxinfo "$pkg" 2>/dev/null)
    if ! printf '%s' "$out" | grep -q 'Total frames rendered'; then
        printf '  %sNo frame data (app may not be rendering).%s\n' "$Y" "$D"
        return 1
    fi
    printf '%s\n' "$out" | grep -E 'Total frames rendered|Janky frames|Number Missed Vsync|Number Slow UI thread' | head -8
    local p50 p90 p95 p99
    p50=$(printf '%s\n' "$out" | grep -m1 '50th percentile' | awk '{print $3}')
    p90=$(printf '%s\n' "$out" | grep -m1 '90th percentile' | awk '{print $3}')
    p95=$(printf '%s\n' "$out" | grep -m1 '95th percentile' | awk '{print $3}')
    p99=$(printf '%s\n' "$out" | grep -m1 '99th percentile' | awk '{print $3}')
    printf '\n  Frame latency (ms): p50=%s  p90=%s  p95=%s  p99=%s\n' "$p50" "$p90" "$p95" "$p99"
    if [ -n "$p90" ] && [ "$p90" -gt 0 ] 2>/dev/null; then
        printf '  FPS estimate (1000/p90): %s%s%s fps\n' "$G" "$((1000 / p90))" "$D"
    fi
}

cmd_topcpu() {
    banner
    printf '  Top CPU consumers:\n\n'
    if command -v top >/dev/null 2>&1; then
        top -b -n 1 -m 15 2>/dev/null | tail -20
    else
        dumpsys cpuinfo 2>/dev/null | head -20
    fi
}

cmd_memrank() {
    banner
    printf '  Top memory consumers:\n\n'
    dumpsys meminfo 2>/dev/null | sed -n '/Total PSS by process:/,/^$/p' | head -22
}

cmd_kill() {
    local pkg="$1"
    if [ -z "$pkg" ]; then
        banner
        printf '  Usage: tboost kill <package.name>\n'
        printf '  Example: tboost kill com.example.game\n'
        return 1
    fi
    banner
    printf '  Force-stopping %s%s%s...\n' "$B" "$pkg" "$D"
    if am force-stop "$pkg" 2>/dev/null; then
        printf '  %sOK%s %s stopped\n' "$G" "$D" "$pkg"
    else
        printf '  %sFAIL%s (system apps need root)\n' "$R" "$D"
    fi
}
cmd_thermal() {
    banner
    printf '  Thermal zones:\n\n'
    local z n t c
    for z in /sys/class/thermal/thermal_zone*; do
        [ -r "$z/temp" ] || continue
        n=$(cat "$z/type" 2>/dev/null); [ -z "$n" ] && n="$(basename "$z")"
        t=$(cat "$z/temp" 2>/dev/null); [ -z "$t" ] && continue
        [ "$t" -gt 1000 ] 2>/dev/null && t=$((t / 1000))
        c=$(temp_color "$t")
        printf '  %-28s %s%4s C%s\n' "$n" "$c" "$t" "$D"
    done
}

cmd_gpu() {
    banner
    printf '  GPU:\n\n'
    local found=0 c m base
    if [ -r /sys/class/kgsl/kgsl-3d0/gpuclk ]; then
        c=$(cat /sys/class/kgsl/kgsl-3d0/gpuclk 2>/dev/null)
        m=$(cat /sys/class/kgsl/kgsl-3d0/max_gpuclk 2>/dev/null)
        [ -n "$c" ] && printf '  Adreno cur: %s MHz\n' "$((c / 1000000))"
        [ -n "$m" ] && printf '  Adreno max: %s MHz\n' "$((m / 1000000))"
        found=1
    fi
    if [ -r /sys/class/kgsl/kgsl-3d0/devfreq/cur_freq ]; then
        c=$(cat /sys/class/kgsl/kgsl-3d0/devfreq/cur_freq 2>/dev/null)
        [ -n "$c" ] && printf '  Adreno devfreq: %s MHz\n' "$((c / 1000000))"
        found=1
    fi
    for f in /sys/class/devfreq/*gpu*/cur_freq /sys/class/misc/mali0/device/devfreq/*/cur_freq; do
        [ -r "$f" ] || continue
        c=$(cat "$f" 2>/dev/null)
        [ -z "$c" ] && continue
        base=$(dirname "$f")
        printf '  %s: %s MHz\n' "$(basename "$base")" "$((c / 1000000))"
        found=1
    done
    [ "$found" -eq 0 ] && printf '  %sNo GPU freq nodes exposed (device specific).%s\n' "$Y" "$D"
}

cmd_battery() {
    banner
    printf '  Battery:\n\n'
    local t cur vol
    t=$(cat /sys/class/power_supply/battery/temp 2>/dev/null)
    [ -n "$t" ] && printf '  Temperature: %s C\n' "$((t / 10))"
    cur=$(cat /sys/class/power_supply/battery/current_now 2>/dev/null)
    [ -n "$cur" ] && printf '  Current:     %s mA\n' "$((cur / 1000))"
    vol=$(cat /sys/class/power_supply/battery/voltage_now 2>/dev/null)
    [ -n "$vol" ] && printf '  Voltage:     %s mV\n' "$((vol / 1000))"
    printf '\n'
    dumpsys battery 2>/dev/null | grep -E 'level|status|health|charge counter' | head -5
}

cmd_io() {
    banner
    printf '  Disk I/O (2s sample):\n\n'
    local r1 w1 r2 w2 line
    r1=0; w1=0
    while IFS= read -r line; do
        set -- $line
        [ "$2" = "0" ] && continue
        r1=$((r1 + ${4:-0}))
        w1=$((w1 + ${8:-0}))
    done < /proc/diskstats
    sleep 2
    r2=0; w2=0
    while IFS= read -r line; do
        set -- $line
        [ "$2" = "0" ] && continue
        r2=$((r2 + ${4:-0}))
        w2=$((w2 + ${8:-0}))
    done < /proc/diskstats
    printf '  Read:  %s KB/s\n' "$(( (r2 - r1) * 512 / 2 / 1024 ))"
    printf '  Write: %s KB/s\n' "$(( (w2 - w1) * 512 / 2 / 1024 ))"
}

cmd_play() {
    local pkg="$1"
    if [ -z "$pkg" ]; then
        banner
        printf '  Usage: tboost play <package.name>\n'
        printf '  Example: tboost play com.mobile.legends\n'
        return 1
    fi
    cmd_game_on
    printf '\n  Launching %s...\n' "$pkg"
    if command -v monkey >/dev/null 2>&1; then
        monkey -p "$pkg" -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1
    else
        am start -n "$pkg" >/dev/null 2>&1
    fi
    printf '  Waiting 5s for frames...\n'
    sleep 5
    cmd_fps "$pkg"
}

cmd_verify() {
    local missing=0 fn
    for fn in detect_root as_root get_temp get_freq get_ram get_governor get_soc \
              temp_color banner backup_state restore_state apply_tweaks \
              cmd_status daemon_alive start_daemon stop_daemon _daemon_main \
              cmd_game_on cmd_game_off cmd_clean cmd_monitor cmd_boot_install \
              cmd_menu cmd_help main \
              get_fg_pkg cmd_fg cmd_fps cmd_topcpu cmd_memrank cmd_kill \
              cmd_thermal cmd_gpu cmd_battery cmd_io cmd_play cmd_gamedetect cmd_kill cmd_access cmd_threads cmd_mem_deep cmd_sf cmd_gpu_deep cmd_thermal_deep cmd_wakelock cmd_batterystat cmd_ffmax_report get_game_pkg run_priv get_access_mode; do
        type "$fn" >/dev/null 2>&1 || { printf 'MISSING: %s\n' "$fn"; missing=$((missing + 1)); }
