_fps_fallback() {
    local pid="$1" mode u n s i w irq sirq st total busy
    mode=$(get_access_mode)
    printf '  %sFallback metrics:%s\n' "$BD" "$D"

    # /proc/stat: coba direct, lalu via rish
    local statline
    if [ -r /proc/stat ]; then
        statline=$(head -1 /proc/stat 2>/dev/null)
    fi
    if [ -z "$statline" ] && [ "$mode" != "user" ]; then
        statline=$(rish -c "head -1 /proc/stat" 2>/dev/null)
    fi

    if [ -n "$statline" ]; then
        read -r _ u n s i w irq sirq st _ <<< "$statline"
        total=$((u+n+s+i+w+irq+sirq+st))
        busy=$((total-i-w))
        [ "$total" -gt 0 ] && printf '      System CPU busy : %s%%\n' "$((busy * 100 / total))"
    else
        printf '      System CPU busy : (unavailable)\n'
    fi

    local mt ma
    if [ -r /proc/meminfo ]; then
        mt=$(awk '/MemTotal/{print $2}' /proc/meminfo)
        ma=$(awk '/MemAvailable/{print $2}' /proc/meminfo)
    elif [ "$mode" != "user" ]; then
        mt=$(rish -c "cat /proc/meminfo" 2>/dev/null | awk '/MemTotal/{print $2}')
        ma=$(rish -c "cat /proc/meminfo" 2>/dev/null | awk '/MemAvailable/{print $2}')
    fi
    [ -n "$mt" ] && [ "$mt" -gt 0 ] 2>/dev/null && \
        printf '      RAM used        : %s MB / %s MB\n' "$(( (mt-ma) / 1024 ))" "$(( mt / 1024 ))"

    printf '      CPU temp        : %s C\n' "$(get_temp)"

    if [ -r /sys/class/kgsl/kgsl-3d0/gpuclk ]; then
        local g bp
        g=$(cat /sys/class/kgsl/kgsl-3d0/gpuclk 2>/dev/null)
        bp=$(cat /sys/class/kgsl/kgsl-3d0/gpu_busy_percentage 2>/dev/null)
        printf '      GPU freq        : %s MHz\n' "$((g / 1000000))"
        [ -n "$bp" ] && printf '      GPU busy        : %s\n' "$bp"
    fi

    [ -n "$pid" ] && printf '      FF MAX PID      : %s\n' "$pid"
}
