cmd_play() {
    local pkg="$1"
    if [ -z "$pkg" ]; then
        banner
        printf '  Usage: tboost play <package.name>\n\n'
        printf '  Contoh:\n'
        printf '    tboost play com.dts.freefireth\n'
        printf '    tboost play com.mobile.legends\n'
        return 1
    fi
    cmd_game_on
    printf '\n  Launching %s...\n' "$pkg"
    monkey -p "$pkg" -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1 \
        || am start -n "$pkg" >/dev/null 2>&1 \
        || printf '  %sGagal launch (cek nama package)%s\n' "$Y" "$D"
    printf '  Menunggu 10 detik agar frame ter-render...\n'
    sleep 10
    cmd_fps "$pkg"
}

cmd_kill() {
    local pkg="$1"
