# --- TEMPERATURE ACCURACY ENGINE ---
_normalize_temp() {
    local v=$1 r
    r=$((v / 1000)); [ "$r" -ge 5 ] && [ "$r" -le 120 ] && { echo "$r"; return; }
    r=$((v / 100));  [ "$r" -ge 5 ] && [ "$r" -le 120 ] && { echo "$r"; return; }
    r=$((v / 10));   [ "$r" -ge 5 ] && [ "$r" -le 120 ] && { echo "$r"; return; }
    [ "$v" -ge 5 ] && [ "$v" -le 120 ] && { echo "$v"; return; }
    echo 0
}

get_temp() {
    local z name raw temp cpu_max=0 valid_max=0
    for z in /sys/class/thermal/thermal_zone*; do
        [ -r "$z/temp" ] || continue
        name=$(cat "$z/type" 2>/dev/null | tr 'A-Z' 'a-z' | tr -d ' ')
        raw=$(cat "$z/temp" 2>/dev/null)
        [ -z "$raw" ] && continue
        case "$raw" in ''|*[!0-9]*) continue ;; esac
        temp=$(_normalize_temp "$raw")
        [ "$temp" -le 0 ] && continue

        case "$name" in
            *batt*|*charg*|*usb*|*bcl*|*flash*|*pa_therm*|*skin*)
                continue
                ;;
            *cpu*|*soc*|*apc*|*big*|*little*|*silver*|*gold*|*prime*|*mtkts*|*tsens*|*core*|*gpu*|*nsp*|*ap_thermal*)
                [ "$temp" -gt "$cpu_max" ] && cpu_max=$temp
                ;;
        esac
        [ "$temp" -gt "$valid_max" ] && valid_max=$temp
    done

    if [ "$cpu_max" -gt 0 ]; then printf '%s\n' "$cpu_max"
    elif [ "$valid_max" -gt 0 ]; then printf '%s\n' "$valid_max"
    else printf '0\n'; fi
}

cmd_temp_debug() {
    banner
    printf '  %s>> TEMPERATURE DEBUG (PER-ZONE) <<%s\n\n' "$BD" "$D"
    printf '  %-28s %-8s %-8s %s\n' "ZONE" "RAW" "TEMP" "STATUS"
    printf '  ------------------------------------------------------------------\n'
    local z name raw temp mark
    for z in /sys/class/thermal/thermal_zone*; do
        [ -r "$z/temp" ] || continue
        name=$(cat "$z/type" 2>/dev/null | tr 'A-Z' 'a-z')
        [ -z "$name" ] && name="(zone_$(basename "$z" | grep -oE '[0-9]+$'))"
        raw=$(cat "$z/temp" 2>/dev/null)
        [ -z "$raw" ] && continue
        case "$raw" in ''|*[!0-9]*) continue ;; esac
        temp=$(_normalize_temp "$raw")
        
        mark="${DM}(valid)${D}"
        case "$name" in
            *batt*|*charg*|*usb*|*bcl*|*flash*|*pa_therm*|*skin*)
                mark="${R}(skip)${D}"
                ;;
            *cpu*|*soc*|*apc*|*big*|*little*|*silver*|*gold*|*prime*|*mtkts*|*tsens*|*core*|*gpu*|*nsp*|*ap_thermal*)
                mark="${G}(CPU) ${D}"
                ;;
        esac
        
        printf '  %-28s %-8s %s%-4s°C%s %s\n' "$name" "$raw" "$G" "$temp" "$D" "$mark"
    done
    printf '\n  %s=> Hasil akhir CPU Temp: %s%s°C%s\n' "$BD" "$G" "$(get_temp)" "$D"
    printf '  %sAngka inilah yang dipakai di dashboard & menu.%s\n\n' "$DM" "$D"
    read -p "  [Enter] " _
}

