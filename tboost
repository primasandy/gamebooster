cmd_threads() {
    banner
    local pkg pid
    pkg="${1:-$(get_game_pkg)}"
    if [ -z "$pkg" ]; then
        printf '  %sPackage tidak terdeteksi.%s\n' "$Y" "$D"
        return 1
    fi
    pid=$(pgrep -f "$pkg" 2>/dev/null | head -1)
    [ -z "$pid" ] && pid=$(ps -A 2>/dev/null | grep -m1 "$pkg" | awk '{print $2}')

    printf '  Package: %s\n' "$pkg"
    printf '  PID    : %s\n\n' "${pid:-unknown}"

    if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
        printf '  Thread count: %s\n' "$(ls /proc/$pid/task 2>/dev/null | wc -l)"
        printf '  Thread states (top 10):\n'
        printf '    %-8s %-20s %-8s\n' "TID" "NAME" "STATE"
        for t in /proc/$pid/task/*; do
            [ -r "$t/comm" ] || continue
            tid=$(basename "$t")
            tn=$(cat "$t/comm" 2>/dev/null)
            ts=$(awk '/^State:/{print $2}' "$t/status" 2>/dev/null)
            printf '    %-8s %-20s %-8s\n' "$tid" "$tn" "$ts"
        done | head -11
        printf '\n  CPU per-thread (1s):\n'
        top -b -H -n 1 -p "$pid" 2>/dev/null | tail -12
    else
        printf '  %s/proc/%s tidak bisa diakses.%s\n' "$Y" "$pid" "$D"
        printf '  Butuh root untuk baca /proc app lain.\n'
    fi
}


cmd_gpu_deep() {
    banner
    printf '  GPU deep info:\n\n'
    local f c m busy
    if [ -r /sys/class/kgsl/kgsl-3d0/gpu_busy_percentage ]; then
        busy=$(cat /sys/class/kgsl/kgsl-3d0/gpu_busy_percentage 2>/dev/null)
        printf '  Adreno busy: %s\n' "$busy"
    fi
    if [ -r /sys/class/kgsl/kgsl-3d0/gpuclk ]; then
        c=$(cat /sys/class/kgsl/kgsl-3d0/gpuclk 2>/dev/null)
        m=$(cat /sys/class/kgsl/kgsl-3d0/max_gpuclk 2>/dev/null)
        printf '  Adreno cur: %s MHz  max: %s MHz\n' "$((c / 1000000))" "$((m / 1000000))"
    fi
    if [ -r /sys/class/kgsl/kgsl-3d0/temp ]; then
        printf '  GPU temp: %s C\n' "$(($(cat /sys/class/kgsl/kgsl-3d0/temp 2>/dev/null) / 1000))"
    fi
    for f in /sys/class/kgsl/kgsl-3d0/devfreq/cur_freq /sys/class/devfreq/*gpu*/cur_freq; do
        [ -r "$f" ] || continue
        c=$(cat "$f" 2>/dev/null)
        printf '  %s: %s MHz\n' "$(basename "$(dirname "$f")")" "$((c / 1000000))"
    done
}

