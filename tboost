            printf '  %s[+]%s /sys/kernel/debug/* (gpu, thermal detailed)\n' "$G" "$D"
            printf '  %s[+]%s procrank / showmap\n' "$G" "$D"
            ;;
        shizuku)
            printf '  %s[+]%s Shizuku detected — ADB-level access\n' "$G" "$D"
            printf '  %s[+]%s dumpsys full scope via rish\n' "$G" "$D"
            printf '  %s[-]%s /proc/PID/* restricted (same as user)\n' "$Y" "$D"
