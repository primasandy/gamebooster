    fi
}
cmd_fps() {
    banner
    local pkg="$1"
    [ -z "$pkg" ] && pkg=$(get_fg_pkg)

    if [ -z "$pkg" ]; then
        printf '  %sPackage tidak terdeteksi.%s\n\n' "$Y" "$D"
        printf '  Cara pakai:\n'
        printf '    tboost fps com.dts.freefireth    (Free Fire)\n'
        printf '    tboost fps com.mobile.legends    (MLBB)\n'
        printf '    tboost fps com.pubg.imobile      (PUBG M)\n'
        return 1
    fi

    printf '  Package: %s%s%s\n\n' "$G" "$pkg" "$D"

    local out
    out=$(dumpsys gfxinfo "$pkg" 2>/dev/null)
    if ! printf '%s' "$out" | grep -q 'Total frames rendered'; then
        printf '  %sBelum ada frame data untuk package ini.%s\n\n' "$Y" "$D"
        printf '  Solusi:\n'
        printf '    - Main game minimal 30 detik\n'
        printf '    - Tekan Home, buka Termux (jangan force-stop game)\n'
        printf '    - Cek package benar: tboost gamedetect\n'
        return 1
    fi

    printf '%s\n' "$out" | grep -E 'Total frames rendered|Janky frames|Number Missed Vsync|Number Slow UI thread' | head -8

    local p50 p90 p95 p99
    p50=$(printf '%s\n' "$out" | grep -m1 '50th percentile' | awk '{print $3}')
    p90=$(printf '%s\n' "$out" | grep -m1 '90th percentile' | awk '{print $3}')
    p95=$(printf '%s\n' "$out" | grep -m1 '95th percentile' | awk '{print $3}')
    p99=$(printf '%s\n' "$out" | grep -m1 '99th percentile' | awk '{print $3}')

    printf '\n  Frame latency (ms): p50=%s  p90=%s  p95=%s  p99=%s\n' "$p50" "$p90" "$p95" "$p99"

    if [ -n "$p90" ] && [ "$p90" -gt 0 ] 2>/dev/null; then
        printf '  FPS estimate: %s%s%s fps\n' "$G" "$((1000 / p90))" "$D"
    fi
}

