cmd_bench() {
    clear
    printf "${C}  CPU BENCHMARK${D}\n\n  Stress test 5 detik...\n\n"
    termux-wake-lock 2>/dev/null
    local start=$(date +%s%N); local count=0; local end
    
    while true; do
        local x=$((RANDOM * RANDOM)); x=$((x % 1000000)); count=$((count + 1))
        end=$(date +%s%N)
        [ $(( (end - start) / 1000000000 )) -ge 5 ] && break
    done
    
    local elapsed=$(( (end - start) / 1000000 ))
    local score=$((count * 1000 / elapsed))
    termux-wake-unlock 2>/dev/null
    
    printf "  Skor: ${G}%s${D} | Waktu: %s ms\n" "$score" "$elapsed"
    [ "$score" -gt 500 ] && printf "  Peringkat: ${G}EXCELLENT${D}\n" || printf "  Peringkat: ${Y}GOOD/AVERAGE${D}\n"
}

