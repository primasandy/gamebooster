# ========== FF MAX Foreground Detection ==========
# Package: com.dts.freefiremax
FF_MAX="com.dts.freefiremax"
FF_CLASSIC="com.dts.freefireth"

get_access_mode() {
    if [ "$HAS_ROOT" -eq 1 ]; then printf 'root\n'
    elif command -v rish >/dev/null 2>&1 && rish -c id 2>/dev/null | grep -q uid; then printf 'shizuku\n'
    else printf 'user\n'; fi
}

run_priv() {
    # Jalankan perintah dengan privilege tertinggi yang tersedia
    local mode
    mode=$(get_access_mode)
    case "$mode" in
        root)    as_root "$*" ;;
        shizuku) rish -c "$*" ;;
        *)       sh -c "$*" ;;
    esac
}

get_fg_pkg() {
    local out pkg mode
    mode=$(get_access_mode)

    # Source 1: activity top via priv
    if [ "$mode" != "user" ]; then
        out=$(run_priv "dumpsys activity top" 2>/dev/null | grep -m1 'ACTIVITY ')
    else
        out=$(dumpsys activity top 2>/dev/null | grep -m1 'ACTIVITY ')
    fi
    pkg=$(printf '%s' "$out" | grep -oE '[a-zA-Z0-9._]+/[a-zA-Z0-9._]+' | head -1 | cut -d'/' -f1)
    [ -n "$pkg" ] && { printf '%s\n' "$pkg"; return; }

    # Source 2: dumpsys window
    if [ "$mode" != "user" ]; then
        out=$(run_priv "dumpsys window windows" 2>/dev/null | grep -m1 -E 'mCurrentFocus|mFocusedApp')
    else
        out=$(dumpsys window windows 2>/dev/null | grep -m1 -E 'mCurrentFocus|mFocusedApp')
    fi
    pkg=$(printf '%s' "$out" | grep -oE '[a-zA-Z0-9._]+/[a-zA-Z0-9._]+' | head -1 | cut -d'/' -f1)
    [ -n "$pkg" ] && { printf '%s\n' "$pkg"; return; }

    # Source 3: activity activities multi-key
    if [ "$mode" != "user" ]; then
        out=$(run_priv "dumpsys activity activities" 2>/dev/null | grep -E 'topResumedActivity|mResumedActivity|ResumedActivity' | grep -v null | head -1)
    else
        out=$(dumpsys activity activities 2>/dev/null | grep -E 'topResumedActivity|mResumedActivity|ResumedActivity' | grep -v null | head -1)
    fi
    pkg=$(printf '%s' "$out" | grep -oE '[a-zA-Z0-9._]+/[a-zA-Z0-9._]+' | head -1 | cut -d'/' -f1)
    [ -n "$pkg" ] && { printf '%s\n' "$pkg"; return; }

    # Source 4: running processes — cari FF MAX yang sedang jalan
    # (fallback kalau foreground benar-benar tidak bisa dibaca)
    if [ "$mode" != "user" ]; then
        out=$(run_priv "ps -A" 2>/dev/null | grep -m1 "$FF_MAX" | awk '{print $NF}')
        [ -z "$out" ] && out=$(run_priv "ps -A" 2>/dev/null | grep -m1 "$FF_CLASSIC" | awk '{print $NF}')
    else
        out=$(ps -A 2>/dev/null | grep -m1 "$FF_MAX" | awk '{print $NF}')
        [ -z "$out" ] && out=$(ps -A 2>/dev/null | grep -m1 "$FF_CLASSIC" | awk '{print $NF}')
    fi
    [ -n "$out" ] && { printf '%s\n' "$out"; return; }

    # Source 5: /proc fallback — cari cmdline
    for d in /proc/[0-9]*; do
        [ -r "$d/cmdline" ] || continue
        pkg=$(tr '\0' '\n' < "$d/cmdline" 2>/dev/null | grep -m1 -E "$FF_MAX|$FF_CLASSIC")
        [ -n "$pkg" ] && { printf '%s\n' "$pkg"; return; }
    done

    printf '\n'
}

get_game_pkg() {
    # Prioritas: FF MAX > FF Classic > foreground apapun
    local p
    p=$(ps -A 2>/dev/null | grep -m1 "$FF_MAX" | awk '{print $NF}')
    [ -n "$p" ] && { printf '%s\n' "$p"; return; }
    p=$(ps -A 2>/dev/null | grep -m1 "$FF_CLASSIC" | awk '{print $NF}')
    [ -n "$p" ] && { printf '%s\n' "$p"; return; }
    get_fg_pkg
}

