cmd_fps_try() {
    local pkg pid out layer fps_val
    pkg=$(get_game_pkg)
    pid=$(get_game_pid "$pkg")
    printf '  %sFPS attempt (Android 16 / SurfaceFlinger)%s\n\n' "$BD" "$D"

    # Hanya bisa via rish
    if ! command -v rish >/dev/null 2>&1 || ! rish -c id 2>/dev/null | grep -q 'uid=2000'; then
        printf '  %s[-]%s rish/Shizuku tidak aktif — FPS tidak bisa dibaca\n' "$Y" "$D"
        printf '  Fallback metrics di bawah:\n\n'
        _fps_fallback "$pid"
        return 1
    fi

    # ---- Method A: SurfaceFlinger --timestats -dump ----
    out=$(rish -c "dumpsys SurfaceFlinger --timestats -dump" 2>/dev/null)
    if [ -n "$out" ]; then
        # Cari blok layer game (freefire / com.dts)
        local block
        block=$(printf '%s\n' "$out" | awk '
            /^layerName = / { in_block = ($0 ~ /freefire|com\.dts/) }
            in_block { print }
        ')
        if [ -n "$block" ]; then
            fps_val=$(printf '%s\n' "$block" | grep -m1 'averageFPS' | awk -F'=' '{print $2}' | tr -d ' ')
            if [ -n "$fps_val" ]; then
                printf '  %s[+]%s Via SurfaceFlinger --timestats\n' "$G" "$D"
                printf '      Layer    : %s\n' "$(printf '%s\n' "$block" | grep -m1 'layerName' | cut -d= -f2 | tr -d ' ')"
                printf '      Avg FPS  : %s%s%s\n' "$G" "$fps_val" "$D"
                printf '%s\n' "$block" | grep -E 'totalFrames|averageFPS|present2Present' | head -4 | sed 's/^/      /'
                return 0
            fi
        fi
    fi

    # ---- Method B: SurfaceFlinger --latency <layer> ----
    layer=$(rish -c "dumpsys SurfaceFlinger --list" 2>/dev/null | grep -iE 'freefire|com\.dts' | head -1)
    if [ -n "$layer" ]; then
        printf '  Layer: %s\n' "$layer"
        out=$(rish -c "dumpsys SurfaceFlinger --latency '$layer'" 2>/dev/null)
        if [ -n "$out" ]; then
            local count=0 sum=0 prev="" vsync
            while read -r _ vsync _; do
                [ -z "$vsync" ] && continue
                [ "$vsync" = "0" ] && continue
                case "$vsync" in *[!0-9]*) continue ;; esac
                if [ -n "$prev" ]; then
                    sum=$((sum + vsync - prev))
                    count=$((count + 1))
                fi
                prev=$vsync
            done < <(printf '%s\n' "$out" | tail -n +2)
            if [ "$count" -gt 0 ]; then
                local avg_ns fps
                avg_ns=$((sum / count))
                [ "$avg_ns" -gt 0 ] && fps=$((1000000000 / avg_ns))
                printf '  %s[+]%s Via SurfaceFlinger --latency\n' "$G" "$D"
                printf '      Frames  : %s\n' "$count"
                printf '      Avg gap : %s ns\n' "$avg_ns"
                printf '      FPS     : %s%s%s\n' "$G" "$fps" "$D"
                return 0
            fi
        fi
    fi

    # ---- Method C: legacy gfxinfo (mungkin gagal di Android 16) ----
    out=$(rish -c "dumpsys gfxinfo $pkg" 2>/dev/null)
    if printf '%s' "$out" | grep -q 'Total frames'; then
        printf '  %s[+]%s Via gfxinfo (legacy)\n' "$G" "$D"
        printf '%s\n' "$out" | grep -E 'Total frames|Janky|percentile' | head -5 | sed 's/^/      /'
        return 0
    fi

    # ---- Semua gagal: kasih fallback metrics ----
    printf '  %s[-]%s SurfaceFlinger tidak memberikan data layer game\n' "$Y" "$D"
    printf '  %sKemungkinan: FF MAX belum render 30 detik, atau pakai SurfaceView (butuh filter beda)%s\n\n' "$DM" "$D"
    _fps_fallback "$pid"
}

_fps_fallback() {
    local pid="$1"
    printf '  %sFallback metrics:%s\n' "$BD" "$D"
    local u n s i w irq sirq st total busy
    read -r _ u n s i w irq sirq st _ < /proc/stat
    total=$((u+n+s+i+w+irq+sirq+st)); busy=$((total-i-w))
    [ "$total" -gt 0 ] && printf '      System CPU busy : %s%%\n' "$((busy * 100 / total))"
    local mt ma
    mt=$(awk '/MemTotal/{print $2}' /proc/meminfo)
    ma=$(awk '/MemAvailable/{print $2}' /proc/meminfo)
    [ "$mt" -gt 0 ] && printf '      RAM used        : %s MB / %s MB\n' "$(( (mt-ma) / 1024 ))" "$(( mt / 1024 ))"
    printf '      CPU temp        : %s C\n' "$(get_temp)"
    if [ -r /sys/class/kgsl/kgsl-3d0/gpuclk ]; then
        local g bp
        g=$(cat /sys/class/kgsl/kgsl-3d0/gpuclk 2>/dev/null)
        bp=$(cat /sys/class/kgsl/kgsl-3d0/gpu_busy_percentage 2>/dev/null)
        printf '      GPU freq        : %s MHz\n' "$((g / 1000000))"
        [ -n "$bp" ] && printf '      GPU busy        : %s\n' "$bp"
    fi
    [ -n "$pid" ] && printf '      FF MAX PID      : %s\n' "$pid"
}
cmd_fpscapture() {
    local pkg="${1:-$FF_MAX}" dur="${2:-60}"
    banner
    printf '  %sCapture FPS — %s detik%s\n\n' "$BD" "$dur" "$D"
    printf '  Alur:\n'
    printf '    1. Script membersihkan & mengaktifkan timestats\n'
    printf '    2. FF MAX dibuka otomatis\n'
    printf '    3. Anda main selama %s detik%s\n' "$dur" "$D"
    printf '    4. Setelah %s detik, hasil tersimpan\n' "$dur"
    printf '    5. Kembali ke Termux, jalankan: tboost fpsresult\n\n'

    if ! command -v rish >/dev/null 2>&1 || ! rish -c id 2>/dev/null | grep -q 'uid=2000'; then
        printf '  %s[-]%s rish/Shizuku tidak aktif\n' "$Y" "$D"
        return 1
    fi

    local logf="$STATE_DIR/fps_capture.log"
    : > "$logf"

    (
        rish -c "dumpsys SurfaceFlinger --timestats -clear" >/dev/null 2>&1
        rish -c "dumpsys SurfaceFlinger --timestats -enable" >/dev/null 2>&1
        printf '[%s] timestats enabled\n' "$(date +%H:%M:%S)" >> "$logf"
        monkey -p "$pkg" -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1 \
            || am start -n "$pkg" >/dev/null 2>&1 \
            || rish -c "am start -n $pkg" >/dev/null 2>&1
        printf '[%s] game launched\n' "$(date +%H:%M:%S)" >> "$logf"
        sleep "$dur"
        rish -c "dumpsys SurfaceFlinger --timestats -dump" > "$logf.dump" 2>/dev/null
        rish -c "dumpsys SurfaceFlinger --timestats -disable" >/dev/null 2>&1
        printf '[%s] timestats dumped -> %s.dump\n' "$(date +%H:%M:%S)" "$logf" >> "$logf"
    ) >/dev/null 2>&1 &

    printf '  %s[+]%s Capture berjalan di background (PID %s)\n\n' "$G" "$D" "$!"
    printf '  FF MAX akan terbuka otomatis.\n'
    printf '  Main sekarang. Setelah %s detik, kembali ke Termux dan jalankan:\n\n' "$dur"
    printf '      tboost fpsresult\n\n'
}

cmd_fpsresult() {
    banner
    local dumpf="$STATE_DIR/fps_capture.log.dump" logf="$STATE_DIR/fps_capture.log"

    if [ ! -s "$dumpf" ]; then
        printf '  %s[!]%s Belum ada capture (atau belum selesai)\n\n' "$Y" "$D"
        printf '  Jalankan dulu: tboost fpscapture 60\n'
