            spin "Swappiness=10" bash -c "sudo sysctl -w vm.swappiness=10 >/dev/null 2>&1"
            spin "Compact Memory" bash -c "echo 1 | sudo tee /proc/sys/vm/compact_memory >/dev/null"
            pid=$(get_game_pid)
            if [ -n "$pid" ] && [ -d "/proc/$pid" ] 2>/dev/null; then
                spin "Boost Game PID $pid" bash -c "sudo renice -n -20 -p $pid; sudo ionice -c 1 -n 0 -p $pid"
            fi
            echo -e "\n  ${G}${BD}[✓] PC GOD MODE ACTIVE!${D}"
            echo -e "  CPU: ${R}${old}${D} → ${G}$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)${D}"
            read -p "  [Enter]" _
        } ;;
        20) check_sudo && {
            spin "Restore default" bash -c "echo ondemand | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null 2>&1; sudo sysctl -w vm.swappiness=60 >/dev/null 2>&1; sudo sysctl -w net.ipv4.tcp_congestion_control=cubic >/dev/null 2>&1"
            echo -e "\n  ${G}[✓] Sistem normal.${D}"; read -p "  [Enter]" _
        } ;;
        21) clear; echo -e "${Y}CPU Benchmark 5 detik...${D}\n"; start=$(date +%s%N); count=0
            while true; do x=$((RANDOM*RANDOM)); count=$((count+1)); now=$(date +%s%N); [ $(( (now-start)/1000000000 )) -ge 5 ] && break; done
            elapsed=$(( (now-start)/1000000 )); score=$((count*1000/elapsed))
            echo -e "  Skor: ${G}$score${D} | Waktu: ${elapsed}ms"
            read -p "  [Enter]" _
        ;;
        0) exit 0 ;;
    esac
done
